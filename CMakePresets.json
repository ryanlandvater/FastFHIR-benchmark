{
  "version": 3,
  "configurePresets": [
    {
      "name": "xcode-debug",
      "displayName": "Xcode (debug test 5)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build-xcode",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ninja-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "xcode-debug", "configurePreset": "xcode-debug", "configuration": "Debug" },
    { "name": "ninja-debug", "configurePreset": "ninja-debug" }
  ]
}
