# macOS
.DS_Store

# Bazel build artifacts (no trailing slash: Bazel creates these as symlinks,
# and a trailing-slash pattern matches directories only)
/bazel-bin
/bazel-out
/bazel-testlogs
/bazel-*
MODULE.bazel.lock

# Python/Jupyter
.ipynb_checkpoints/
__pycache__/
*.pyc
.env
.venv/
.ruff_cache/
notebooks/analysis_exports/
notebooks/benchmark_outputs/
notebooks/.bench_tmp/

# Arbiter
.arbiter/

# Benchmark result artifacts should not be committed at repo root
BENCHMARK_RESULTS.md
BENCHMARK_SUMMARY.txt

# Build outputs
build/
build-*/
out/
cmake-build-*/
dist/
bin/
obj/
local/
.external/
xcode/
docs/

# Artifacts and runtime data.
#
# The per-arm wire artifacts are regenerated by `bench_harness --dump-artifacts`
# and are never committed -- but the DIRECTORY has to exist, because main.cpp
# opens artifacts/<arm>.bin with ofstream, never creates the directory, and
# never checks the stream: a missing directory reports "wrote N bytes" and
# writes nothing. Hence `artifacts/*` plus the .keep negation rather than a
# plain `artifacts/`, which would exclude the directory itself and make the
# negation unreachable -- git does not descend into an excluded directory, so
# no `!` rule under it can ever match.
artifacts/*
!artifacts/.keep
datasets/*
!datasets/.keep
logs/
profiles/
metrics/
notebooks/results/
*.log
*.sqlite
*.db


# Terraform local state
*.tfstate
*.tfstate.backup
.terraform/
.terraform.lock.hcl

# Docker local overrides
docker-compose.override.yml

# Memoized corpus digest (IN-0). Derived from datasets/synthea, cheap to
# recompute, and machine-specific -- the corpus itself is not checked in.
datasets/.corpus_sha256.cache

# Development benchmark runs and rendered figures. Regenerated by every sweep
# (harness stdout + scripts/plot_benchmarks.py) -- not source of truth.
results/

# script(1) typescript log from an interactive session
started

# Session handoff notes. Internal, agent-to-agent working documents -- they
# describe what to do next, not what the project IS, and both repos are public.
# Two were tracked until 2026-09-08 (1,205 and 740 lines) and read as internal
# process noise on a repo whose value is its credibility. Write them if they
# help; do not commit them.
handoff.md
handoff*.md
HANDOFF*.md
