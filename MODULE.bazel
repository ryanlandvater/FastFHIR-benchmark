module(
    name = "fastfhir_benchmarking",
    version = "0.1.0",
)

# First on purpose: apple_support's Apple CC toolchain must be registered before
# rules_cc's generic one. Xcode 27 reports SDKSettings.json as a compile input,
# which the generic toolchain rejects as an "absolute path inclusion"; the
# Apple toolchain treats /Applications as builtin. No effect off macOS.
bazel_dep(name = "apple_support", version = "2.8.3", repo_name = "build_bazel_apple_support")
bazel_dep(name = "fastfhir", version = "2026.0.0")
# The version actually compiled: rules_python 1.9.0 (via fastfhir) and rules_cc
# both require 29.0-rc3, so declaring 27.0 only produced a resolution warning.
# Moving to a stable 29.x changes the google_fhir arm -- decide that separately.
bazel_dep(name = "protobuf", version = "29.0-rc3", repo_name = "com_google_protobuf")

local_path_override(
    module_name = "fastfhir",
    path = ".external/FastFHIR",
)
