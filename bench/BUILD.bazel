package(default_visibility = ["//visibility:public"])

cc_library(
    name = "bench_core_common",
    srcs = [
        "arm_fastfhir.cpp",
        "arm_json_fhir.cpp",
        "arm_ndjson.cpp",
        "synthea_fixture.cpp",
    ],
    hdrs = [
        "bench_test_1.hpp",
        "bench_test_2.hpp",
        "bench_test_3.hpp",
        "bench_test_4.hpp",
        "bench_test_5.hpp",
        "arm_fastfhir_codec.hpp",
        "arm_google_fhir_codec.hpp",
        "arm_hl7v2_codec.hpp",
        "arm_json_codec.hpp",
        "arm_ndjson_codec.hpp",
        "harness.hpp",
        "json_leaf_walk.hpp",
        "json_syntax_repair.hpp",
        "poco_leaves.hpp",
        "poco_set.hpp",
        "walk_diagnostic.hpp",
        "hl7v2_message.hpp",
    ],
    deps = [
        ":bench_provenance",
        "//:fastfhir_runtime",
        "@nlohmann_json//:json",
    ],
)

# Build provenance for the release artifact (TASKS.md IN-0). Header-only and
# dependency-free: the SHA-256 used for the corpus digest is implemented in the
# header rather than pulled from boringssl, which is in the graph via FastFHIR's
# targets but not visible to this module -- and a repo whose point is hermetic,
# identically-built comparison arms should not grow a crypto dep to hash a
# directory. provenance_test checks it against the FIPS 180-4 vectors.
cc_library(
    name = "bench_provenance",
    hdrs = ["provenance.hpp"],
)

# Split from bench_core_harness to keep //:google_fhir_runtime -- protobuf plus
# the generated google-fhir protos -- OUT of this arm. That is the dependency
# that makes a Windows build awkward, and it is the whole reason for the split.
#
# NOT dependency-free, and never was: bench_core_common brings //:fastfhir_runtime
# and @nlohmann_json, so the older "pure C++ with zero platform deps" wording
# overstated it from the start. nlohmann is now a DIRECT need as well -- the v2
# arm decodes the ZFX passthrough segments, whose payloads are JSON fragments --
# rather than something inherited and unused.
#
# Both remaining deps are header-portable, so the Windows rationale still holds;
# it is narrower than it read.
cc_library(
    name = "bench_core_hl7v2",
    srcs = ["arm_hl7v2.cpp"],
    deps = [
        ":bench_core_common",
        ":bench_provenance",
    ],
)

cc_library(
    name = "bench_core_harness",
    srcs = [
        "arm_google_fhir.cpp",
    ],
    deps = [
        ":bench_core_common",
        ":bench_core_hl7v2",
        ":bench_provenance",
        "//:google_fhir_runtime",
    ],
)

# The four-arm benchmark. PostgreSQL persistence is OPT-IN: see
# :bench_harness_pg below. main.cpp guards every libpq call behind
# HAVE_LIBPQ, so this target is the complete benchmark minus the --db flag,
# and it builds on any machine.
#
# Why libpq is not linked here: the previous form passed
# copts = ["-I/opt/homebrew/opt/libpq/include"], which Bazel rejects as "a path
# outside of the execution root" under sandboxed compilation regardless of
# whether libpq is installed. An absolute -I cannot be made hermetic; a
# new_local_repository can. See WORKSPACE.bazel :libpq_macos.
cc_binary(
    name = "bench_harness",
    srcs = ["main.cpp"],
    data = ["enrich.json"],
    deps = [
        ":bench_core_harness",
        ":bench_provenance",
    ],
    defines = ["HAVE_GOOGLE_FHIR", "HAVE_HL7V2"],
)

# Same benchmark with --db PostgreSQL persistence. Requires libpq on the host:
#   brew install libpq
# and LIBPQ_MACOS_PATH pointed at its prefix if it is not the Homebrew default.
cc_binary(
    name = "bench_harness_pg",
    srcs = ["main.cpp"],
    data = ["enrich.json"],
    deps = [
        ":bench_core_harness",
        ":bench_provenance",
        "@libpq_macos//:libpq",
    ],
    defines = ["HAVE_GOOGLE_FHIR", "HAVE_HL7V2", "HAVE_LIBPQ"],
    target_compatible_with = ["@platforms//os:macos"],
    # "manual" keeps //bench:all from trying to fetch @libpq_macos on a machine
    # that has no libpq installed. Build this target by name when you want --db.
    tags = ["manual"],
)

cc_binary(
    name = "bench_timing_conformance",
    srcs = ["timing_conformance_test.cpp"],
    data = ["enrich.json"],
    deps = [
        ":bench_core_common",
    ],
)

# Instrument G -- resilience & integrity suite (TODO.md spec, IN-G). Four
# pass/fail tests, none of them timers: truncation detection, bit-flip
# detection (structural vs payload vs checksum), type-confusion prevention,
# and concurrent build integrity. Run: bazel run -c opt //bench:resilience_test
cc_binary(
    name = "resilience_test",
    srcs = ["resilience_test.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":bench_core_common",
        ":bench_provenance",
    ],
)

# Instrument G test 5 -- FFHR content-level diagnostics (REC-15 apply():
# --mode extract/verify report correct/lost/wrong/spurious leaf values after
# repair; --mode count/report/recover print the reconciliation breakdown).
# The cross-format recovery CURVE is produced by //bench:bench_test_5 +
# scripts/recovery_sweep.py (macro-parity driver, anchored subset check);
# this probe stays as the FFHR apply() instrumentation.
cc_binary(
    name = "corruption_probe",
    srcs = ["corruption_probe.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":bench_core_common",
        ":bench_core_hl7v2",
        "//:google_fhir_runtime",
    ],
    defines = ["PROBE_HAS_FASTFHIR", "PROBE_HAS_JSON", "PROBE_HAS_PROTOBUF", "PROBE_HAS_HL7V2"],
)

# Diagnostic for the FFHR recovery phase transition (recovery-ON collapses
# between k=32 and k=40 flips). Replays a corrupt+recover trial and reports
# the FF_RecoveryReport verdict census, the FF_ApplyReport, and every byte
# apply() wrote -- tagged AT-FLIP vs NOT-FLIP (a repair that rewrites a byte
# the corruption never touched is wrong by construction).
cc_binary(
    name = "recovery_probe",
    srcs = ["recovery_probe.cpp"],
    copts = ["-std=c++20"],
    deps = [":bench_core_common"],
)

# Instrument G test 5 driver (macro-parity restructure). Links the four arm
# TUs -- each compiled bench_test_5.hpp under its own ARM_* macro -- and
# dispatches five INDEPENDENT process modes: --hash (clean-wire fingerprint,
# the baseline producer), --corrupt, --recover, --check (a third process that
# holds the baseline and verifies recovered units are a content-verified
# subset of it), and --positions (the structural-position count that
# normalizes the k axis per format). See bench_test_5.cpp for the CLI and the
# binary fingerprint-file format. Driven by scripts/recovery_sweep.py.
cc_binary(
    name = "bench_test_5",
    srcs = ["bench_test_5.cpp"],
    copts = ["-std=c++20"],
    deps = [
        ":bench_core_harness",
        ":bench_provenance",
    ],
)

# Read-path validation binary — reports whole-document traversal costs as an
# average per Bundle entry and gates on <= 50 us/entry (regression bound for
# optimized builds). Run: bazelisk run //bench:read_path_bench -- <file.ffhr>
cc_binary(
    name = "read_path_bench",
    srcs = ["read_path_bench.cpp"],
    copts = ["-std=c++20"],
    deps = [
        "//:fastfhir_runtime",
    ],
)

# Windows build: all four arms, Google FHIR included -- it differs from
# :bench_harness_pg only in which libpq it links. target_compatible_with keeps
# //bench:all from trying to fetch @libpq_win on macOS/Linux.
cc_binary(
    name = "bench_harness_win",
    srcs = ["main.cpp"],
    data = ["enrich.json"],
    deps = [
        ":bench_core_harness",
        ":bench_provenance",
        "@libpq_win//:libpq",
    ],
    defines = ["HAVE_GOOGLE_FHIR", "HAVE_HL7V2", "HAVE_LIBPQ"],
    target_compatible_with = ["@platforms//os:windows"],
)

cc_test(
    name = "timing_conformance_test",
    srcs = ["timing_conformance_test.cpp"],
    data = ["enrich.json"],
    deps = [
        ":bench_core_common",
    ],
)

# The provenance gate: SHA-256 vectors + the missing_fields() enforcement that
# decides whether numbers may become an artifact at all (TASKS.md IN-0).
cc_test(
    name = "provenance_test",
    srcs = ["provenance_test.cpp"],
    deps = [":bench_provenance"],
)
